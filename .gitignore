# ---- data (never commit raw or processed datasets) ----
data/raw/
data/processed/
# demo playback media: downloaded from the official MicroLens source, never
# redistributed here (size + licence)
data/demo_media/
*.inter
*_feat.npy

# ---- trained weights / indices (regenerable, tens of MB) ----
*.pt
*.pth
*.ckpt
*.index
artifacts/*.npy
artifacts/*.npz

# ---- per-run outputs (configs, logs, checkpoints, ranking dumps) ----
results/runs/
results/logs/

# ---- pre-fix runs and their tables: kept on disk as evidence, never aggregated ----
results/legacy_pre_autoregressive_fix/*
!results/legacy_pre_autoregressive_fix/README.md

# ---- keep the small, human-readable evidence the README links to ----
!results/figures/*.png
!results/tables/*.csv
!results/case_study.md
!results/case_study.json
!artifacts/semantic_ids_*.npz
!artifacts/semantic_id_report_*.json
!artifacts/rqvae_sweep_*.json
!artifacts/smoke_test_results.json
!artifacts/raw_data_report.json
!artifacts/itemcf_report.json
!artifacts/semantic_index_report.json
!artifacts/demo_manifest.json
!artifacts/demo_media_manifest.json
!artifacts/item_id_mapping.json
!artifacts/media_archive_index.json

# ---- demo screenshots are small and referenced by the README ----
!assets/*.png

# ---- frontend ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
*.swp
nohup.out
